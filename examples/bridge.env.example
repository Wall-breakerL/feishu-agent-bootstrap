# Copy OUTSIDE the repository, e.g. ~/.config/feishu-agent/bridge.env, mode 600.
# This is trusted Bash syntax. Never source an untrusted environment file.
export PROJECT_NAME='my-project'
export PROJECT_DIR='/root/autodl-tmp/projects/my-project'
export BRIDGE_STATE_DIR='/root/.local/state/feishu-agent/my-project'
export FEISHU_APP_ID='REPLACE_WITH_APP_ID'
export FEISHU_APP_SECRET='REPLACE_WITH_APP_SECRET'
export FEISHU_ALLOW_FROM='REPLACE_WITH_YOUR_OPEN_ID'

# Only for claude-deepseek. Use an explicit model accepted by your account.
export DEEPSEEK_API_KEY='REPLACE_WITH_API_KEY'
export DEEPSEEK_MODEL='deepseek-flash'

# Only for claude-anthropic (API, not subscription login).
# export CLAUDE_API_KEY='REPLACE_WITH_API_KEY'
# export CLAUDE_MODEL='REPLACE_WITH_SUPPORTED_MODEL'

# Codex: ChatGPT device login as the same OS user; no OpenAI API key.
# Use a separate private env file, App ID and state directory for each robot.
# Optional networking: load examples/proxy.env.example privately after adapting.
