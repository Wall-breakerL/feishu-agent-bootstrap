# Copy outside Git to ~/.config/feishu-agent/codex.env; chmod 600.
# No OPENAI_API_KEY: log in with ChatGPT as the same OS user.
export BRIDGE_PROFILE='codex-approval'
export USE_SERVER_PROXY=1
export PROJECT_NAME='demo-codex'
export PROJECT_DIR='/root/autodl-tmp/feishu-agent-demo/codex'
export BRIDGE_STATE_DIR='/root/.local/state/feishu-agent/codex'
export FEISHU_APP_ID='REPLACE_WITH_CODEX_APP_ID'
export FEISHU_APP_SECRET='REPLACE_WITH_CODEX_APP_SECRET'
export FEISHU_ALLOW_FROM='REPLACE_WITH_CODEX_OWNER_OPEN_ID'
