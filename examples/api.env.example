# Copy outside Git to ~/.config/feishu-agent/api.env; chmod 600.
export BRIDGE_PROFILE='claude-deepseek'
export USE_SERVER_PROXY=0
export PROJECT_NAME='demo-api'
export PROJECT_DIR='/root/autodl-tmp/feishu-agent-demo/api'
export BRIDGE_STATE_DIR='/root/.local/state/feishu-agent/api'
export FEISHU_APP_ID='REPLACE_WITH_API_APP_ID'
export FEISHU_APP_SECRET='REPLACE_WITH_API_APP_SECRET'
export FEISHU_ALLOW_FROM='REPLACE_WITH_API_OWNER_OPEN_ID'
export DEEPSEEK_API_KEY='REPLACE_WITH_API_KEY'
export DEEPSEEK_MODEL='deepseek-flash'
