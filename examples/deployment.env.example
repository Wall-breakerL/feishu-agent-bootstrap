# Copy to ~/.config/feishu-agent/deployment.env; chmod 600.
# Update every executable path after checking the target machine.
export BOOTSTRAP_ROOT='/root/tools/feishu-agent-bootstrap'
export TOOL_ROOT='/root/.local/opt/feishu-agent'
export DEPLOY_STATE_DIR='/root/.local/state/feishu-agent'
export DEPLOY_PYTHON='/root/miniconda3/bin/python'
export SUPERVISORD='/absolute/path/to/supervisord'
export SUPERVISORCTL='/absolute/path/to/supervisorctl'
