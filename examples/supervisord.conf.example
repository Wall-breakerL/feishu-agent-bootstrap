[unix_http_server]
file=%(ENV_DEPLOY_STATE_DIR)s/supervisor.sock
chmod=0700

[supervisord]
logfile=%(ENV_DEPLOY_STATE_DIR)s/logs/supervisord.log
pidfile=%(ENV_DEPLOY_STATE_DIR)s/supervisord.pid
childlogdir=%(ENV_DEPLOY_STATE_DIR)s/logs
nodaemon=false
umask=0077

[rpcinterface:supervisor]
supervisor.rpcinterface_factory=supervisor.rpcinterface:make_main_rpcinterface

[supervisorctl]
serverurl=unix://%(ENV_DEPLOY_STATE_DIR)s/supervisor.sock

[program:mihomo]
command=/bin/bash "%(ENV_BOOTSTRAP_ROOT)s/scripts/run-service.sh" mihomo run
directory=%(ENV_BOOTSTRAP_ROOT)s
autostart=false
autorestart=true
startsecs=3
startretries=3
stopwaitsecs=30
stopasgroup=true
killasgroup=true
redirect_stderr=true
stdout_logfile=%(ENV_DEPLOY_STATE_DIR)s/logs/mihomo.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=3

[program:api]
command=/bin/bash "%(ENV_BOOTSTRAP_ROOT)s/scripts/run-service.sh" api run
directory=%(ENV_BOOTSTRAP_ROOT)s
autostart=false
autorestart=true
startsecs=3
startretries=3
stopwaitsecs=30
stopasgroup=true
killasgroup=true
redirect_stderr=true
stdout_logfile=%(ENV_DEPLOY_STATE_DIR)s/logs/api.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=3

[program:codex]
command=/bin/bash "%(ENV_BOOTSTRAP_ROOT)s/scripts/run-service.sh" codex run
directory=%(ENV_BOOTSTRAP_ROOT)s
autostart=false
autorestart=true
startsecs=3
startretries=3
stopwaitsecs=30
stopasgroup=true
killasgroup=true
redirect_stderr=true
stdout_logfile=%(ENV_DEPLOY_STATE_DIR)s/logs/codex.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=3
