# Copy outside the repo; source only in the bridge/login process environment.
# Requires a running server-side Mihomo and a working user-supplied node.
export HTTP_PROXY='http://127.0.0.1:7890'
export HTTPS_PROXY="$HTTP_PROXY"
export http_proxy="$HTTP_PROXY"
export https_proxy="$HTTPS_PROXY"
# Both apex and suffix entries, for differing client implementations.
# Extend according to observed Feishu WebSocket hostnames and actual API hosts.
export NO_PROXY='localhost,127.0.0.1,::1,feishu.cn,.feishu.cn,feishucdn.com,.feishucdn.com,deepseek.com,.deepseek.com'
export no_proxy="$NO_PROXY"
# Remove conflicting inherited ALL_PROXY in this dedicated shell if necessary.
